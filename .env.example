# Copy to .env (optional). All values have safe defaults.
PORT=8000
# default: backend/data
# SEALCHECK_DATA_DIR=/absolute/path/to/data
# SEALCHECK_DB_URL=postgresql+psycopg://user:pass@localhost/sealcheck
# default: seed/samples
# SEALCHECK_SAMPLES_DIR=/absolute/path/to/samples
SEALCHECK_JWT_SECRET=
SEALCHECK_JWT_TTL_MIN=480
SEALCHECK_JOB_TOKEN_TTL_S=60
SEALCHECK_MAX_UPLOAD_MB=15
SEALCHECK_WORKER_CPU_S=45
SEALCHECK_WORKER_MEM_MB=1536
# Demo pacing: artificial delay per pipeline stage (ms), 0 = off
SEALCHECK_DEMO_PACE_MS=0
# Optional: an LLM only rewrites explanations; statuses never change
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SEALCHECK_LLM_MODEL=gpt-4o-mini
